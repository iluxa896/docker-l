APP_NAME="Магазин милых вещей"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost
OZON_STORE_URL="https://www.ozon.ru"

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=7
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_OR_NULL_FOR_LOCAL
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin Credentials Configuration (Used during database seeding / first deployment)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Dozzle Log Viewer Configuration
DOZZLE_USER=admin
DOZZLE_PASSWORD=CHANGE_ME_STRONG_DOZZLE_PASSWORD
DOZZLE_EMAIL=admin@example.com

# Beszel Server & Container Monitoring Configuration
BESZEL_USER_EMAIL=admin@example.com
BESZEL_USER_PASSWORD=CHANGE_ME_STRONG_BESZEL_PASSWORD

# Search Engine Webmaster Verification (Optional)
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
