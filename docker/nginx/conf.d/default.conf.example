server {
    listen 80;
    listen [::]:80;
    http2 on;
    server_name localhost;
    root /var/www/html/public;

    ssl_session_cache shared:SSL:10m;

    absolute_redirect off;
    server_tokens off;

    # Restrict incoming request/body size (belt-and-suspenders with Laravel 5MB validation)
    client_max_body_size 8M;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: https://images.unsplash.com https://cdn.ozon.ru https://ir.ozone.ru; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # 301 Redirect www to non-www mirror
    if ($host ~* ^www\.(.+)$) {
        return 301 $scheme://$1$request_uri;
    }

    index index.php;

    charset utf-8;

    # Gzip compression for static assets
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    location / {
        # 301 Redirect trailing slashes for non-directories
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ACME-challenge for Let's Encrypt HTTP-01 verification (works even with read-only root)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
        allow all;
    }

    # Redirect /dozzle to /dozzle/
    location = /dozzle {
        return 302 $scheme://$http_host/dozzle/;
    }

    # Proxy Dozzle Log Viewer with WebSocket support (dynamic DNS resolver prevents startup crash)
    location /dozzle/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $dozzle_upstream http://dozzle:8080;
        proxy_pass $dozzle_upstream;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /dozzle;
        proxy_cache_bypass $http_upgrade;
    }

    # Redirect /beszel to /beszel/
    location = /beszel {
        return 302 $scheme://$http_host/beszel/;
    }

    # Proxy Beszel Server Monitoring with WebSocket support (dynamic DNS resolver prevents startup crash)
    location /beszel/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $beszel_upstream http://beszel:8090;

        proxy_read_timeout 360s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        rewrite ^/beszel/(.*) /$1 break;

        proxy_pass $beszel_upstream;
    }


    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; try_files $uri /index.php?$query_string; }

    # Intercept upstream errors (502/504 when PHP-FPM container is booting or down) and return 503 Maintenance Page
    fastcgi_intercept_errors on;
    error_page 502 503 504 =503 /maintenance.html;
    error_page 404 /index.php;

    location = /maintenance.html {
        root /usr/share/nginx/html;
        internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Retry-After 60 always;
    }

    location ~ \.php$ {
        resolver 127.0.0.11 valid=5s ipv6=off;
        set $app_upstream app:9000;
        fastcgi_pass $app_upstream;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_hide_header X-Frame-Options;
        fastcgi_hide_header X-Content-Type-Options;
        fastcgi_hide_header Referrer-Policy;
        fastcgi_hide_header Permissions-Policy;
        fastcgi_hide_header Content-Security-Policy;
        fastcgi_connect_timeout 2s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 60s;
    }

    # Block access to hidden files and sensitive project files
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* (\.env|\.git|\.yml|\.yaml|\.sql|\.bak|\.inc|\.conf|\.sh)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}
